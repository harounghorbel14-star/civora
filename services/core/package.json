{
  "name": "@civora/core",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "civora-core modular monolith \u2014 Phase 2 walking skeleton (O-A1): health, locales, feature flags, i18n, base schemas, OpenAPI pipeline. No business features.",
  "main": "dist/src/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/src/main.js",
    "test": "node --test \"dist/src/**/*.test.js\"",
    "openapi": "node dist/scripts/generate-openapi.js openapi/core.openapi.json",
    "openapi:check": "node dist/scripts/generate-openapi.js openapi/.generated.json && node -e \"const a=require('fs').readFileSync('openapi/core.openapi.json','utf8'),b=require('fs').readFileSync('openapi/.generated.json','utf8');if(a!==b){console.error('OpenAPI contract out of date: run pnpm openapi');process.exit(1)}\" && node scripts/validate-openapi.mjs openapi/core.openapi.json",
    "migrate": "node-pg-migrate up --migrations-dir migrations --migration-file-language sql --migrations-table schema_migrations --check-order",
    "migrate:down": "node-pg-migrate down 1 --migrations-dir migrations --migration-file-language sql --migrations-table schema_migrations --check-order",
    "openapi:validate": "node scripts/validate-openapi.mjs openapi/core.openapi.json"
  },
  "dependencies": {
    "@civora/country-packs": "workspace:*",
    "@civora/feature-flags": "workspace:*",
    "@civora/i18n": "workspace:*",
    "@nestjs/common": "11.2.8",
    "@nestjs/core": "11.2.8",
    "@nestjs/platform-express": "11.2.8",
    "@nestjs/swagger": "11.4.8",
    "@prometheus-io/client": "0.16.1",
    "node-pg-migrate": "8.0.4",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@seriousme/openapi-schema-validator": "2.11.0",
    "@types/express": "5.0.3",
    "@types/node": "22.20.5",
    "@types/pg": "8.15.5",
    "typescript": "5.9.3"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.map",
    "migrations",
    "openapi/core.openapi.json"
  ]
}
