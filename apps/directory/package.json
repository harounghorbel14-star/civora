{
  "name": "@civora/directory",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "Public pages of the Government Services Directory (Phase 5, P5-D3, P5-A2): static HTML generated from the signed, published catalogue. No JavaScript in the pages; content whose signature does not verify is never written.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": { "civora-directory": "dist/cli.js" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test \"dist/**/*.test.js\"",
    "generate": "node dist/cli.js"
  },
  "dependencies": {
    "@civora/credentials": "workspace:*",
    "@civora/i18n": "workspace:*",
    "jose": "6.2.15",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "26.6.10",
    "@types/react": "19.3.1",
    "@types/react-dom": "19.3.0",
    "typescript": "5.9.3"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*"
  ]
}
