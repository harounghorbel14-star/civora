{
  "name": "@civora/web",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "CIVORA citizen web app (Phase 3: accounts). Backend-for-frontend: tokens stay on the server; the browser holds an HttpOnly session cookie.",
  "scripts": {
    "build": "NEXT_TELEMETRY_DISABLED=1 next build",
    "start": "NEXT_TELEMETRY_DISABLED=1 next start",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test \".test-dist/lib/**/*.test.js\""
  },
  "dependencies": {
    "@civora/i18n": "workspace:*",
    "jose": "6.2.15",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "5.9.3"
  }
}
