{
  "name": "civora-platform",
  "private": true,
  "description": "CIVORA platform monorepo (working name, decision P1-D13 pending). Phase 2 walking skeleton.",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=22.0.0" },
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r --workspace-concurrency=1 run test",
    "arch:check": "node scripts/check-module-boundaries.mjs",
    "openapi": "pnpm --filter @civora/core run openapi",
    "synth": "pnpm --filter @civora/synthetic-data run synth",
    "packs:verify": "pnpm --filter @civora/country-packs run verify"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/node": "26.6.10"
  }
}
