{
  "realm": "civora-staff",
  "displayName": "CIVORA",
  "enabled": true,
  "sslRequired": "external",
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "bruteForceProtected": true,
  "failureFactor": 5,
  "permanentLockout": false,
  "waitIncrementSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "quickLoginCheckMilliSeconds": 1000,
  "minimumQuickLoginWaitSeconds": 60,
  "maxDeltaTimeSeconds": 43200,
  "passwordPolicy": "length(12) and notUsername and notEmail and passwordHistory(5) and maxLength(128)",
  "accessTokenLifespan": 300,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "internationalizationEnabled": true,
  "supportedLocales": [
    "ar",
    "fr",
    "en"
  ],
  "defaultLocale": "ar",
  "otpPolicyType": "totp",
  "otpPolicyAlgorithm": "HmacSHA1",
  "otpPolicyDigits": 6,
  "otpPolicyPeriod": 30,
  "otpPolicyLookAheadWindow": 1,
  "registrationAllowed": false,
  "attributes": {
    "civora.profile": "staff",
    "civora.purpose": "Staff of the institutions (tenants) of one cell, and officers (P3-A1). Every account needs a FIDO2 security key (P3-SEC5), enrolled from an e-mailed invitation before the password; institution SSO brokering in week 3 (P3-R1)."
  },
  "webAuthnPolicyRpEntityName": "CIVORA Workspace",
  "webAuthnPolicySignatureAlgorithms": [
    "ES256",
    "RS256"
  ],
  "webAuthnPolicyUserVerificationRequirement": "required",
  "webAuthnPolicyAuthenticatorAttachment": "cross-platform",
  "webAuthnPolicyAttestationConveyancePreference": "direct",
  "browserFlow": "staff-browser",
  "authenticationFlows": [
    {
      "alias": "staff-browser",
      "description": "Password + FIDO2 security key, always; an account without a key is refused",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-cookie",
          "requirement": "ALTERNATIVE",
          "authenticatorFlow": false,
          "userSetupAllowed": false,
          "priority": 10
        },
        {
          "flowAlias": "staff-forms",
          "requirement": "ALTERNATIVE",
          "authenticatorFlow": true,
          "userSetupAllowed": false,
          "priority": 20
        }
      ]
    },
    {
      "alias": "staff-forms",
      "description": "",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-username-password-form",
          "requirement": "REQUIRED",
          "authenticatorFlow": false,
          "userSetupAllowed": false,
          "priority": 10
        },
        {
          "flowAlias": "staff-key",
          "requirement": "CONDITIONAL",
          "authenticatorFlow": true,
          "userSetupAllowed": false,
          "priority": 20
        },
        {
          "flowAlias": "staff-no-second-factor",
          "requirement": "CONDITIONAL",
          "authenticatorFlow": true,
          "userSetupAllowed": false,
          "priority": 30
        }
      ]
    },
    {
      "alias": "staff-key",
      "description": "Runs only when the account has this second factor",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "conditional-user-configured",
          "requirement": "REQUIRED",
          "authenticatorFlow": false,
          "userSetupAllowed": false,
          "priority": 10
        },
        {
          "authenticator": "webauthn-authenticator",
          "requirement": "REQUIRED",
          "authenticatorFlow": false,
          "userSetupAllowed": false,
          "priority": 20
        }
      ]
    },
    {
      "alias": "staff-no-second-factor",
      "description": "An account without its second factor cannot sign in; first credentials come only from the activation link",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "conditional-sub-flow-executed",
          "requirement": "REQUIRED",
          "authenticatorFlow": false,
          "userSetupAllowed": false,
          "authenticatorConfig": "staff-second-factor-not-run",
          "priority": 10
        },
        {
          "authenticator": "deny-access-authenticator",
          "requirement": "REQUIRED",
          "authenticatorFlow": false,
          "userSetupAllowed": false,
          "authenticatorConfig": "staff-deny-no-second-factor",
          "priority": 20
        }
      ]
    },
    {
      "alias": "deny-direct-grant",
      "description": "No password grant in this realm: every login goes through the browser flow and its second factor",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "deny-access-authenticator",
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false,
          "authenticatorFlow": false
        }
      ]
    }
  ],
  "requiredActions": [
    {
      "alias": "webauthn-register",
      "name": "Webauthn Register",
      "providerId": "webauthn-register",
      "enabled": true,
      "defaultAction": false,
      "priority": 10,
      "config": {}
    },
    {
      "alias": "UPDATE_PASSWORD",
      "name": "Update Password",
      "providerId": "UPDATE_PASSWORD",
      "enabled": true,
      "defaultAction": false,
      "priority": 20,
      "config": {}
    },
    {
      "alias": "VERIFY_EMAIL",
      "name": "Verify Email",
      "providerId": "VERIFY_EMAIL",
      "enabled": true,
      "defaultAction": false,
      "priority": 30,
      "config": {}
    },
    {
      "alias": "UPDATE_PROFILE",
      "name": "Update Profile",
      "providerId": "UPDATE_PROFILE",
      "enabled": true,
      "defaultAction": false,
      "priority": 40,
      "config": {}
    },
    {
      "alias": "CONFIGURE_TOTP",
      "name": "Configure OTP",
      "providerId": "CONFIGURE_TOTP",
      "enabled": true,
      "defaultAction": false,
      "priority": 50,
      "config": {}
    },
    {
      "alias": "webauthn-register-passwordless",
      "name": "Webauthn Register Passwordless",
      "providerId": "webauthn-register-passwordless",
      "enabled": true,
      "defaultAction": false,
      "priority": 60,
      "config": {}
    },
    {
      "alias": "update_user_locale",
      "name": "Update User Locale",
      "providerId": "update_user_locale",
      "enabled": true,
      "defaultAction": false,
      "priority": 70,
      "config": {}
    }
  ],
  "roles": {
    "realm": [
      {
        "name": "tenant-admin",
        "description": "Administrator of one institution (tenant)"
      },
      {
        "name": "case-handler",
        "description": "Handles cases for one institution"
      },
      {
        "name": "supervisor",
        "description": "Supervises handlers of one institution"
      },
      {
        "name": "officer",
        "description": "Public-sector officer (Government track)"
      },
      {
        "name": "default-roles-civora-staff",
        "description": "Roles every account of this realm receives",
        "composite": true,
        "composites": {
          "client": {
            "account": [
              "view-profile"
            ]
          }
        }
      }
    ]
  },
  "clients": [
    {
      "clientId": "civora-workspace",
      "name": "CIVORA Workspace (staff console)",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": true,
      "redirectUris": [
        "https://workspace.civora-cell.invalid/*"
      ],
      "webOrigins": [
        "https://workspace.civora-cell.invalid"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "https://workspace.civora-cell.invalid/*",
        "civora.client-kind": "first-party"
      },
      "protocolMappers": [
        {
          "name": "audience civora-core",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "civora-core",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "tenant",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "tenant_id",
            "claim.name": "tenant_id",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "civora-core",
      "name": "civora-core API (resource server)",
      "publicClient": false,
      "bearerOnly": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false
    },
    {
      "clientId": "admin-cli",
      "name": "${client_admin-cli}",
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false
    }
  ],
  "components": {
    "org.keycloak.userprofile.UserProfileProvider": [
      {
        "providerId": "declarative-user-profile",
        "subComponents": {},
        "config": {
          "kc.user.profile.config": [
            "{\"attributes\":[{\"name\":\"username\",\"displayName\":\"${username}\",\"validations\":{\"length\":{\"min\":3,\"max\":255},\"username-prohibited-characters\":{},\"up-username-not-idn-homograph\":{}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"email\",\"displayName\":\"${email}\",\"validations\":{\"email\":{},\"length\":{\"max\":255}},\"required\":{\"roles\":[\"user\"]},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"firstName\",\"displayName\":\"${firstName}\",\"validations\":{\"length\":{\"max\":255},\"person-name-prohibited-characters\":{}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"lastName\",\"displayName\":\"${lastName}\",\"validations\":{\"length\":{\"max\":255},\"person-name-prohibited-characters\":{}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"tenant_id\",\"displayName\":\"Institution (tenant) id\",\"validations\":{\"pattern\":{\"pattern\":\"^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$\",\"error-message\":\"tenant id must be a UUID\"}},\"required\":{\"roles\":[\"admin\"]},\"permissions\":{\"view\":[\"admin\"],\"edit\":[\"admin\"]},\"multivalued\":false}],\"groups\":[{\"name\":\"user-metadata\",\"displayHeader\":\"User metadata\",\"displayDescription\":\"Attributes, which refer to user metadata\"}]}"
          ]
        }
      }
    ]
  },
  "defaultRole": {
    "name": "default-roles-civora-staff",
    "composite": true
  },
  "webAuthnPolicyResidentKey": "discouraged",
  "directGrantFlow": "deny-direct-grant",
  "authenticatorConfig": [
    {
      "alias": "staff-second-factor-not-run",
      "config": {
        "flow_to_check": "staff-key",
        "check_result": "not-executed"
      }
    },
    {
      "alias": "staff-deny-no-second-factor",
      "config": {
        "denyErrorMessage": "civoraNoSecurityKey"
      }
    }
  ],
  "displayNameHtml": "${civoraRealmName}",
  "localizationTexts": {
    "ar": {
      "civoraRealmName": "CIVORA — فضاء الأعوان",
      "civoraNoSecurityKey": "لا يمكن الدخول دون مفتاح أمان مسجَّل. استعمل رابط الدعوة أو اتصل بمسؤول مؤسستك."
    },
    "fr": {
      "civoraRealmName": "CIVORA — Espace agents",
      "civoraNoSecurityKey": "Connexion impossible sans clé de sécurité enregistrée. Utilisez le lien d'invitation ou contactez l'administrateur de votre institution."
    },
    "en": {
      "civoraRealmName": "CIVORA — Staff and officers",
      "civoraNoSecurityKey": "You cannot sign in without an enrolled security key. Use your invitation link or contact your institution's administrator."
    }
  },
  "webAuthnPolicyAcceptableAaguids": []
}
