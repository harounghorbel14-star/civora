{
  "realm": "sim-bank-a-idp",
  "displayName": "SIMULATED institution identity provider: bank A (OIDC), synthetic staff only",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "resetPasswordAllowed": false,
  "rememberMe": false,
  "bruteForceProtected": true,
  "failureFactor": 5,
  "accessTokenLifespan": 60,
  "ssoSessionIdleTimeout": 300,
  "ssoSessionMaxLifespan": 600,
  "internationalizationEnabled": true,
  "supportedLocales": [
    "ar",
    "fr",
    "en"
  ],
  "defaultLocale": "fr",
  "clients": [
    {
      "clientId": "civora-staff-broker",
      "name": "CIVORA staff realm (identity broker)",
      "description": "Confidential client of the CIVORA staff realm. Redirect URI and secret set when the tenant's SSO is configured.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "consentRequired": false,
      "frontchannelLogout": false,
      "fullScopeAllowed": false,
      "redirectUris": [
        "http://localhost:8080/realms/civora-staff/broker/sim-bank-a/endpoint"
      ],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": ""
      },
      "defaultClientScopes": [
        "basic",
        "email",
        "profile"
      ],
      "optionalClientScopes": []
    }
  ]
}
