# Managed by Ansible (CIVORA, role postgresql_ha)
ETCD_NAME="{{ inventory_hostname }}"
ETCD_DATA_DIR="/var/lib/etcd/civora"
ETCD_LISTEN_PEER_URLS="https://{{ ansible_host }}:2380"
ETCD_LISTEN_CLIENT_URLS="https://{{ ansible_host }}:2379"
ETCD_INITIAL_ADVERTISE_PEER_URLS="https://{{ ansible_host }}:2380"
ETCD_ADVERTISE_CLIENT_URLS="https://{{ ansible_host }}:2379"
ETCD_INITIAL_CLUSTER="{% for h in postgresql_ha_etcd_members %}{{ h }}=https://{{ hostvars[h]['ansible_host'] }}:2380{{ '' if loop.last else ',' }}{% endfor %}"
ETCD_INITIAL_CLUSTER_STATE="new"
ETCD_INITIAL_CLUSTER_TOKEN="{{ postgresql_ha_scope }}"
ETCD_CERT_FILE="{{ postgresql_ha_tls_dir }}/node.crt"
ETCD_KEY_FILE="{{ postgresql_ha_tls_dir }}/node.key"
ETCD_TRUSTED_CA_FILE="{{ postgresql_ha_tls_dir }}/ca.crt"
ETCD_CLIENT_CERT_AUTH="true"
ETCD_PEER_CERT_FILE="{{ postgresql_ha_tls_dir }}/node.crt"
ETCD_PEER_KEY_FILE="{{ postgresql_ha_tls_dir }}/node.key"
ETCD_PEER_TRUSTED_CA_FILE="{{ postgresql_ha_tls_dir }}/ca.crt"
ETCD_PEER_CLIENT_CERT_AUTH="true"
