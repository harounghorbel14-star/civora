# Managed by Ansible (CIVORA, role postgresql_ha)
[Unit]
Description=Daily differential backup

[Timer]
OnCalendar={{ postgresql_ha_backup_diff_schedule if postgresql_ha_local_repo | int == 1 else postgresql_ha_repo2_backup_diff_schedule }}
Persistent=true
Unit=pgbackrest-backup@diff.service

[Install]
WantedBy=timers.target
