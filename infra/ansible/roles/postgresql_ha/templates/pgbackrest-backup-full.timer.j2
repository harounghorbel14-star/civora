# Managed by Ansible (CIVORA, role postgresql_ha)
[Unit]
Description=Weekly full backup

[Timer]
OnCalendar={{ postgresql_ha_backup_full_schedule if postgresql_ha_local_repo | int == 1 else postgresql_ha_repo2_backup_full_schedule }}
Persistent=true
Unit=pgbackrest-backup@full.service

[Install]
WantedBy=timers.target
