# Managed by Ansible (CIVORA, role postgresql_ha)
[Unit]
Description=pgBackRest TLS server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{ 'pgbackrest' if inventory_hostname in groups['backup'] else 'postgres' }}
Group={{ 'pgbackrest' if inventory_hostname in groups['backup'] else 'postgres' }}
ExecStart=/usr/bin/pgbackrest server
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=5
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target
