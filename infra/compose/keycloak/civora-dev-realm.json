{
  "realm": "civora-dev",
  "displayName": "CIVORA development (synthetic users only)",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "bruteForceProtected": true,
  "failureFactor": 5,
  "permanentLockout": false,
  "maxFailureWaitSeconds": 900,
  "passwordPolicy": "length(12) and notUsername and notEmail and passwordHistory(5)",
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "internationalizationEnabled": true,
  "supportedLocales": [
    "ar",
    "fr",
    "en"
  ],
  "defaultLocale": "ar",
  "attributes": {
    "civora.purpose": "Phase 2 dev cell. Realm per country cell; tenants are organisations (ADR-005, ADR-016)."
  },
  "roles": {
    "realm": [
      {
        "name": "platform-operator",
        "description": "CIVORA operations staff (break-glass audited)"
      },
      {
        "name": "tenant-admin",
        "description": "Administrator of one tenant (financial institution or agency)"
      },
      {
        "name": "case-handler",
        "description": "Staff member handling cases for one tenant"
      },
      {
        "name": "customer",
        "description": "End customer of a tenant (OTP sign-in from Phase 3)"
      }
    ]
  },
  "clients": [
    {
      "clientId": "civora-workspace",
      "name": "CIVORA Workspace (staff console)",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "redirectUris": [
        "http://localhost:3100/*"
      ],
      "webOrigins": [
        "http://localhost:3100"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:3100/*"
      },
      "protocolMappers": [
        {
          "name": "tenant",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "tenant_id",
            "claim.name": "tenant_id",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "civora-core",
      "name": "civora-core API (resource server)",
      "publicClient": false,
      "bearerOnly": true,
      "standardFlowEnabled": false
    }
  ],
  "users": [
    {
      "username": "handler.synthetic",
      "email": "handler@synthetic.invalid",
      "firstName": "Agent",
      "lastName": "Exemple",
      "enabled": true,
      "emailVerified": true,
      "attributes": {
        "tenant_id": [
          "00000000-0000-7000-8000-000000000001"
        ]
      },
      "realmRoles": [
        "case-handler"
      ]
    },
    {
      "username": "admin.synthetic",
      "email": "tenant-admin@synthetic.invalid",
      "firstName": "Admin",
      "lastName": "Exemple",
      "enabled": true,
      "emailVerified": true,
      "attributes": {
        "tenant_id": [
          "00000000-0000-7000-8000-000000000001"
        ]
      },
      "realmRoles": [
        "tenant-admin"
      ]
    }
  ]
}
