{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://civora.invalid/schemas/country-pack.schema.json",
  "title": "CIVORA country pack",
  "type": "object",
  "additionalProperties": false,
  "required": ["packId", "version", "status", "country", "locales", "currency", "timeZone", "calendar", "hosting", "dataProtection", "identifiers", "rulePacks", "featureFlags"],
  "properties": {
    "packId": { "type": "string", "pattern": "^[a-z]{2}$" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "status": { "enum": ["synthetic-development-only", "pilot-approved", "production-approved"] },
    "country": {
      "type": "object", "additionalProperties": false, "required": ["iso3166", "name"],
      "properties": { "iso3166": { "type": "string", "pattern": "^[A-Z]{2}$" }, "name": { "type": "object", "additionalProperties": { "type": "string" } } }
    },
    "locales": {
      "type": "object", "additionalProperties": false, "required": ["supported", "default", "fallback", "numberingSystem"],
      "properties": {
        "supported": { "type": "array", "items": { "type": "string" }, "minItems": 1, "uniqueItems": true },
        "default": { "type": "string" },
        "fallback": { "type": "string" },
        "numberingSystem": { "type": "string" }
      }
    },
    "currency": { "type": "object", "additionalProperties": false, "required": ["code", "minorUnits"], "properties": { "code": { "type": "string", "pattern": "^[A-Z]{3}$" }, "minorUnits": { "type": "integer", "minimum": 0, "maximum": 4 } } },
    "timeZone": { "type": "string" },
    "calendar": {
      "type": "object", "additionalProperties": false, "required": ["weekend", "holidays", "holidayDataStatus"],
      "properties": {
        "weekend": { "type": "array", "items": { "enum": ["mon", "tue", "wed", "thu", "fri", "sat", "sun"] } },
        "holidayDataStatus": { "type": "string" },
        "holidays": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false, "required": ["date", "name", "kind", "verified"],
            "properties": { "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }, "name": { "type": "string" }, "kind": { "enum": ["fixed", "lunar-estimate"] }, "verified": { "type": "boolean" } }
          }
        }
      }
    },
    "hosting": {
      "type": "object", "additionalProperties": false, "required": ["devStaging", "pilotProduction", "personalDataTransferAbroad"],
      "properties": { "devStaging": { "type": "string" }, "pilotProduction": { "type": "string" }, "personalDataTransferAbroad": { "type": "string" } }
    },
    "dataProtection": { "type": "object", "required": ["law", "authority"], "properties": { "law": { "type": "string" }, "authority": { "type": "string" }, "authorityStatusNote": { "type": "string" } } },
    "identifiers": { "type": "object", "additionalProperties": { "type": "object", "required": ["pattern", "syntheticPattern"], "properties": { "pattern": { "type": "string" }, "syntheticPattern": { "type": "string" }, "note": { "type": "string" } } } },
    "rulePacks": { "type": "array", "items": { "type": "string", "pattern": "^RP-[A-Z0-9-]+$" }, "uniqueItems": true },
    "featureFlags": { "type": "object", "additionalProperties": { "type": ["boolean", "string", "number"] } }
  }
}
