{
  "name": "@civora/country-packs",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "Country packs and rule packs (ADR-017, FR-66): validated, digest-checked configuration. TN pack v0 is for synthetic development only.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
