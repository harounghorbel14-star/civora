    "manifest": "node dist/cli.js manifest tn",
    "verify": "node dist/cli.js verify tn"
  },
  "dependencies": {
    "ajv": "8.18.0"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/node": "22.20.5"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "tn",
    "schema"
  ]
}
