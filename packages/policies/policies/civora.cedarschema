// CIVORA authorisation model (ADR-006, Cedar). Platform part: the Workspace RF rules (PRD 1.1) and the Government-track
// Tier T0 (health) rule, from the O-A7 spike. Tiers per Phase 0 §10.1: 0 special category, 1 high, 2 moderate, 3 public.
// Mandate part (Phase 3, P3-F5/F6/T4): a person's own records, and an agent acting under a mandate.
entity Tenant;
entity User = { tenant: Tenant, roles: Set<String>, unit: String };
entity Customer = { tenant: Tenant };
entity Case = { tenant: Tenant, unit: String, customer: Customer, dataTier: Long };
entity RulePackActivation = { tenant: Tenant };

type RequestContext = {
  mfa: Bool,
  breakGlass: Bool,
  justification: String,
  purpose: String,
  consent: Bool,
};

action "case:read", "case:update", "case:readInternalNotes", "case:exportForMediator"
  appliesTo { principal: [User], resource: [Case], context: RequestContext };
action "case:readStatus"
  appliesTo { principal: [Customer], resource: [Case], context: RequestContext };
action "rulepack:configure"
  appliesTo { principal: [User], resource: [RulePackActivation], context: RequestContext };

// ---- Mandates (Phase 3). A Person is a citizen; a PersonalRecord is one of their records in a domain. ----
entity Person;
entity Mandate = { principal: Person, agent: Person, scopes: Set<String>, active: Bool };
entity PersonalRecord = { owner: Person, domain: String };

type MandateContext = {
  actingUnder?: Mandate,
};

action "cases:read", "cases:submit", "cases:manage",
       "documents:read", "documents:submit", "documents:manage",
       "appointments:read", "appointments:submit", "appointments:manage",
       "payments:read", "payments:submit", "payments:manage",
       "benefits:read", "benefits:submit", "benefits:manage",
       "identity:manage", "mandates:manage"
  appliesTo { principal: [Person], resource: [PersonalRecord], context: MandateContext };
