// cases: own records, never while acting for someone else.
@id("M1-own-cases")
permit (principal is Person, action in [Action::"cases:read", Action::"cases:submit", Action::"cases:manage"], resource is PersonalRecord)
when { resource.owner == principal && resource.domain == "cases" && !(context has actingUnder) };

// cases:read for the principal, by the agent of an active mandate whose scopes cover it (cases:read or cases:submit or cases:manage).
@id("M2-mandate-cases-read")
permit (principal is Person, action == Action::"cases:read", resource is PersonalRecord)
when {
  context has actingUnder &&
  context.actingUnder.agent == principal &&
  context.actingUnder.active &&
  context.actingUnder.principal == resource.owner &&
  resource.domain == "cases" &&
  context.actingUnder.scopes.containsAny(["cases:read", "cases:submit", "cases:manage"])
};

